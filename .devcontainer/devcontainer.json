{
	"name": "ElectroShop (.NET and SQLite)",
	"image": "mcr.microsoft.com/devcontainers/dotnet:2-10.0-noble",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"remoteUser": "vscode",
	"runArgs": [
		"--network=host"
	],
	"postCreateCommand": "dotnet tool restore && dotnet restore",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"qwtel.sqlite-viewer"
			]
		}
	}
}
