{
	"name": "ElectroShop (.NET and SQLite)",
	"image": "mcr.microsoft.com/devcontainers/dotnet:2-10.0-noble",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"remoteUser": "vscode",
	"runArgs": [
		"--network=host"
	],
	"containerEnv": {
		"DOTNET_GCServer": "0",
		"DOTNET_CLI_DO_NOT_USE_MSBUILD_SERVER": "1",
		"MSBUILDDISABLENODEREUSE": "1"
	},
	"postCreateCommand": "dotnet tool restore && dotnet restore -nr:false",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csharp",
				"qwtel.sqlite-viewer"
			],
			"settings": {
				"remote.autoForwardPorts": false,
				"remote.restoreForwardedPorts": false,
				"dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "openFiles",
				"dotnet.backgroundAnalysis.compilerDiagnosticsScope": "openFiles",
				"csharp.format.enable": true
			}
		}
	}
}
