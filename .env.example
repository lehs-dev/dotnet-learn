# ============================================================
#  ElectroShop — Cấu hình môi trường LOCAL (đặt tên file: .env)
#  File này đã được gitignore, không commit lên GitHub.
#  Mật khẩu dưới đây dễ nhớ, CHỈ dùng cho máy dev học tập.
# ============================================================

# --- 1. Cơ sở dữ liệu (SQLite) -------------------------------
ConnectionStrings__DefaultConnection='Data Source=ElectroShop.db'

# --- 2. Bảo mật JWT ------------------------------------------
# Khóa bí mật để API ký token đăng nhập (tối thiểu 32 ký tự)
Jwt__Key='ElectroShop-Khoa-Bi-Mat-Cua-Son-2026-Dai-Hon-32-Ky-Tu'

# --- 3. Tài khoản Admin --------------------------------------
# Chỉ seed ở môi trường Development. Đăng nhập tại /admin/login
Seed__AdminEmail='admin@electroshop.local'
Seed__AdminPassword='Hoangson2005@'

# --- 4. Môi trường chạy --------------------------------------
ASPNETCORE_ENVIRONMENT='Development'

# Tùy chọn (để mặc định là được):
# Database__Initialize=true            # Development tự migrate + seed khi API khởi động
# Api__BaseUrl='http://localhost:5100/' # Địa chỉ API cho frontend
