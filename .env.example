# Sao chép thành .env (đã gitignore). Chỉnh hostname theo container của bạn.
# Server=db nếu .devcontainer/docker-compose.yml dùng service db; không tạo SQL mới.
ConnectionStrings__DefaultConnection='Server=db,1433;Database=ElectroShopDb;User Id=sa;Password=REPLACE_WITH_EXISTING_SQL_PASSWORD;Encrypt=true;TrustServerCertificate=true'
# Tạo khóa riêng >=32 byte, ví dụ: openssl rand -hex 48
Jwt__Key='REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES'
Seed__AdminEmail='admin@example.test'
# >=8 ký tự; gồm hoa, thường, số, ký tự đặc biệt. Chỉ seed Admin ở Development.
Seed__AdminPassword='REPLACE_WITH_YOUR_OWN_STRONG_PASSWORD'
ASPNETCORE_ENVIRONMENT='Development'
# Tùy chọn: Api__BaseUrl='http://localhost:5100/' (mặc định tại từng frontend)
# Database__Initialize=true # Development tự migrate+seed khi API khởi động
