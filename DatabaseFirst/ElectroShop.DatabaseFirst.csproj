<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project minh họa DATABASE FIRST: không viết entity bằng tay.
       DbContext và các entity trong thư mục Models/ được dotnet-ef scaffold sinh ngược từ
       database ElectroShopDbFirst (tạo bằng schema.sql). Project này đứng ngoài solution
       ElectroShop.sln để không ảnh hưởng ứng dụng chính; build/run độc lập. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ElectroShop.DatabaseFirst</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
