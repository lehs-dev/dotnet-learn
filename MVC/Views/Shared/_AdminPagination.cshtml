@model (AdminViewModel State, int TotalPages)
@if (Model.TotalPages > 1) { <nav class="pagination" aria-label="Phân trang quản trị">@if (Model.State.Page > 1) { <a class="button secondary small" asp-controller="Admin" asp-action="Index" asp-route-tab="@Model.State.Tab" asp-route-q="@Model.State.Q" asp-route-status="@Model.State.Status" asp-route-page="@(Model.State.Page-1)">← Trước</a> }<span>Trang @Model.State.Page / @Model.TotalPages</span>@if (Model.State.Page < Model.TotalPages) { <a class="button secondary small" asp-controller="Admin" asp-action="Index" asp-route-tab="@Model.State.Tab" asp-route-q="@Model.State.Q" asp-route-status="@Model.State.Status" asp-route-page="@(Model.State.Page+1)">Sau →</a> }</nav> }
