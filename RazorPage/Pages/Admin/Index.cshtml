@page "/admin"
@model ElectroShop.RazorPages.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Quản trị cửa hàng";
    var tabs = new[]
    {
        ("dashboard", "Tổng quan", "M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z"),
        ("orders", "Đơn hàng", "M6 3h12v18H6z M9 7h6 M9 12h6 M9 17h4"),
        ("products", "Sản phẩm", "m12 3 9 5v9l-9 5-9-5V8z M3 8l9 5 9-5 M12 13v9 M7 5l9 5"),
        (
            "customers",
            "Khách hàng",
            "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8 M17 4a4 4 0 0 1 0 8 M22 21v-2a4 4 0 0 0-3-4"
        ),
        ("accounts", "Tài khoản", "M12 3 3 7v5c0 5 9 10 9 10s9-5 9-10V7z M8 12l3 3 5-6"),
    };
    var descriptions = new Dictionary<string, string>
    {
        ["dashboard"] = "Theo dõi doanh thu, đơn hàng và hoạt động của cửa hàng.",
        ["orders"] = "Tra cứu đơn mua hàng và cập nhật tiến độ giao hàng.",
        ["products"] = "Quản lý sản phẩm, giá bán, tồn kho và danh mục.",
        ["customers"] = "Quản lý thông tin liên hệ và lịch sử mua sắm của khách hàng.",
        ["accounts"] = "Quản lý vai trò và trạng thái truy cập của các tài khoản.",
    };
}
<div class="page-heading">
    <div>
        <span class="eyebrow">KHÔNG GIAN QUẢN LÝ</span>
        <h1>Quản trị cửa hàng</h1>
        <p class="page-description">@descriptions[Model.Tab]</p>
    </div>
    <a class="button secondary" href="/">Xem cửa hàng <span aria-hidden="true">↗</span></a>
</div>
<div class="admin-layout">
    <nav class="admin-sidebar" aria-label="Khu vực quản trị">
        <span class="admin-sidebar-label">QUẢN LÝ CỬA HÀNG</span>
        @foreach (var tab in tabs)
        {
            <a
                class="tab-button @(Model.Tab == tab.Item1 ? "active" : "")"
                href="/admin?tab=@tab.Item1"
                aria-current="@(Model.Tab == tab.Item1 ? "page" : null)">
                <svg class="tab-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="@tab.Item3" />
                </svg>
                @tab.Item2
            </a>
        }
    </nav>
    <section class="admin-content" aria-label="@tabs.First(x => x.Item1 == Model.Tab).Item2">
        @if (Model.Error is not null)
        {
            <div class="alert error" role="alert">
                @Model.Error
                <a href="@HttpContext.Request.Path@HttpContext.Request.QueryString">Thử tải lại</a>
            </div>
        }
        @if (Model.Tab == "dashboard" && Model.Dashboard is { } dashboard)
        {
            <h2>Tổng quan hoạt động</h2>
            <div class="stats-grid">
                <article class="stat-card">
                    <span>Sản phẩm</span>
                    <strong>@dashboard.TotalProducts</strong>
                </article>
                <article class="stat-card">
                    <span>Khách hàng</span>
                    <strong>@dashboard.TotalCustomers</strong>
                </article>
                <article class="stat-card">
                    <span>Đơn hàng</span>
                    <strong>@dashboard.TotalOrders</strong>
                </article>
                <article class="stat-card">
                    <span>Doanh thu đã thanh toán</span>
                    <strong>@ShopPageModel.Vnd(dashboard.Revenue)</strong>
                </article>
                <article class="stat-card">
                    <span>Đơn chờ xử lý</span>
                    <strong>@dashboard.PendingOrders</strong>
                </article>
            </div>
            <div class="page-heading">
                <h3>Đơn hàng gần nhất</h3>
                <a href="/admin?tab=orders">Xem tất cả →</a>
            </div>
            @if (dashboard.RecentOrders.Count == 0)
            {
                <div class="empty-state">
                    <h3>Chưa có đơn hàng</h3>
                    <p>Đơn hàng mới sẽ xuất hiện tại đây khi khách hàng mua sắm.</p>
                    <a class="button secondary" href="/">Xem cửa hàng</a>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in dashboard.RecentOrders)
                            {
                                <tr>
                                    <td>
                                        <a href="/admin?tab=orders&q=@order.OrderCode">@order.OrderCode</a>
                                    </td>
                                    <td>@order.CustomerName</td>
                                    <td class="money-cell">@ShopPageModel.Vnd(order.TotalAmount)</td>
                                    <td>
                                        <span class="badge">@ShopPageModel.OrderState(order.OrderStatus)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (Model.Tab != "dashboard")
        {
            <h2>
                @(Model.Tab == "accounts" ? "Quản lý tài khoản" : tabs.First(x => x.Item1 == Model.Tab).Item2)
            </h2>
            <form method="get" class="filters" role="search">
                <input type="hidden" name="tab" value="@Model.Tab" />
                <label class="field">
                    @(Model.Tab is "customers" or "accounts" ? "Tìm theo tên, email hoặc điện thoại" : "Tìm kiếm")
                    <input
                        type="search"
                        name="q"
                        value="@Model.Q"
                        placeholder="@(Model.Tab == "orders" ? "Mã đơn hoặc khách hàng…" : Model.Tab == "products" ? "Tên sản phẩm hoặc mã SKU…" : "Nhập tên, email hoặc số điện thoại…")" />
                </label>
                @if (Model.Tab == "orders")
                {
                    <label class="field">
                        Trạng thái
                        <select name="status">
                            <option value="">Tất cả trạng thái</option>
                            @foreach (var status in Enum.GetValues<OrderStatus>())
                            {
                                <option value="@status" selected="@(Model.Status == status.ToString())">
                                    @ShopPageModel.OrderState(status)
                                </option>
                            }
                        </select>
                    </label>
                }
                <button type="submit" class="button">Tìm kiếm</button>
                <a href="/admin?tab=@Model.Tab" class="button secondary">Đặt lại</a>
            </form>
            @if (Model.Error is null)
            {
                <p class="result-count">
                    Tìm thấy
                    <strong>@Model.TotalCount</strong>
                    @(Model.Tab == "orders" ? "đơn hàng" : Model.Tab == "products" ? "sản phẩm" : Model.Tab == "customers" ? "khách hàng" : "tài khoản")
                </p>
            }

            @if (Model.Tab == "orders" && Model.Orders is not null)
            {
                @foreach (var order in Model.Orders.Items)
                {
                    <article class="admin-panel">
                        <p class="muted">Khách hàng: <strong>@order.CustomerName</strong></p>
                        <partial name="_OrderCard" model="order" />
                        @if (ElectroShop.RazorPages.Pages.Admin.IndexModel.NextStatuses(order).Any())
                        {
                            <form method="post" asp-page-handler="OrderStatus" class="inline-form">
                                <input
                                    type="hidden"
                                    name="returnUrl"
                                    value="@(HttpContext.Request.Path + HttpContext.Request.QueryString)" />
                                <input type="hidden" name="id" value="@order.Id" />
                                <label>
                                    Chuyển trạng thái
                                    <select name="status">
                                        @foreach (var status in ElectroShop.RazorPages.Pages.Admin.IndexModel.NextStatuses(order))
                                        {
                                            <option value="@status">@ShopPageModel.OrderState(status)</option>
                                        }
                                    </select>
                                </label>
                                <button class="button small">Cập nhật</button>
                            </form>
                        }
                    </article>
                }
            }

            @if (Model.Tab == "products")
            {
                <details class="summary-card">
                    <summary>Thêm sản phẩm mới</summary>
                    <partial
                        name="_ProductEditor"
                        model="@(new ProductEditor(0, new ProductRequest(), Model.Categories))" />
                </details>
                @if (Model.Products is not null && Model.Products.Items.Count > 0)
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>SKU / Danh mục</th>
                                    <th>Giá / Tồn kho</th>
                                    <th>Hiển thị</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model.Products.Items)
                                {
                                    <tr>
                                        <td>
                                            <strong>@product.Name</strong>
                                            <details>
                                                <summary>Sửa sản phẩm</summary>
                                                <partial name="_ProductEditor" model="@(ProductEditor.From(product, Model.Categories))" />
                                            </details>
                                        </td>
                                        <td>
                                            @product.SKU
                                            <br />
                                            <small>@product.CategoryName</small>
                                        </td>
                                        <td>
                                            <span class="money-cell">@ShopPageModel.Vnd(product.Price)</span>
                                            <br />
                                            <small>@product.StockQuantity sản phẩm</small>
                                        </td>
                                        <td>
                                            <span class="badge @(product.IsActive ? "success" : "neutral")">
                                                @(product.IsActive ? "Đang bán" : "Đã ẩn")
                                            </span>
                                        </td>
                                        <td>
                                            <form method="post" asp-page-handler="HideProduct" data-confirm="Ẩn sản phẩm này khỏi cửa hàng?">
                                                <input
                                                    type="hidden"
                                                    name="returnUrl"
                                                    value="@(HttpContext.Request.Path + HttpContext.Request.QueryString)" />
                                                <input type="hidden" name="id" value="@product.Id" />
                                                <button class="button danger small" disabled="@(!product.IsActive)">Ẩn</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <h3 class="section-heading">Danh mục sản phẩm</h3>
                <details class="summary-card">
                    <summary>Thêm danh mục mới</summary>
                    <form method="post" asp-page-handler="Category">
                        <input
                            type="hidden"
                            name="returnUrl"
                            value="@(HttpContext.Request.Path + HttpContext.Request.QueryString)" />
                        <div class="form-grid">
                            <label class="field">
                                Tên danh mục
                                <input name="category.Name" required maxlength="100" />
                            </label>
                            <label class="field">
                                Slug
                                <input name="category.Slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="100" />
                            </label>
                            <label class="field full-width">
                                Mô tả
                                <textarea name="category.Description" maxlength="1000"></textarea>
                            </label>
                        </div>
                        <input type="hidden" name="category.IsActive" value="true" />
                        <button class="button">Thêm danh mục</button>
                    </form>
                </details>
                @foreach (var category in Model.Categories)
                {
                    <details class="summary-card">
                        <summary>
                            @category.Name
                            <span class="badge @(category.IsActive ? "success" : "neutral")">
                                @(category.IsActive ? "Hiển thị" : "Đã ẩn")
                            </span>
                        </summary>
                        <form method="post" asp-page-handler="Category">
                            <input
                                type="hidden"
                                name="returnUrl"
                                value="@(HttpContext.Request.Path + HttpContext.Request.QueryString)" />
                            <input type="hidden" name="id" value="@category.Id" />
                            <div class="form-grid">
                                <label class="field">
                                    Tên danh mục
                                    <input name="category.Name" value="@category.Name" required maxlength="100" />
                                </label>
                                <label class="field">
                                    Slug
                                    <input
                                        name="category.Slug"
                                        value="@category.Slug"
                                        required
                                        pattern="[a-z0-9]+(-[a-z0-9]+)*"
                                        maxlength="100" />
                                </label>
                                <label class="field full-width">
                                    Mô tả
                                    <textarea name="category.Description" maxlength="1000">@category.Description</textarea>
                                </label>
                                <label>
                                    <input name="category.IsActive" type="checkbox" value="true" checked="@category.IsActive" />
                                    Hiển thị
                                    <input name="category.IsActive" type="hidden" value="false" />
                                </label>
                            </div>
                            <button class="button">Lưu danh mục</button>
                        </form>
                        <form
                            method="post"
                            asp-page-handler="HideCategory"
                            data-confirm="Ẩn danh mục và toàn bộ sản phẩm thuộc danh mục này khỏi cửa hàng?">
                            <input
                                type="hidden"
                                name="returnUrl"
                                value="@(HttpContext.Request.Path + HttpContext.Request.QueryString)" />
                            <input type="hidden" name="id" value="@category.Id" />
                            <button class="button danger small" disabled="@(!category.IsActive)">Ẩn danh mục</button>
                        </form>
                    </details>
                }
            }

            @if (
                Model.Tab is "customers" or "accounts"
                && Model.Customers is not null
                && Model.Customers.Items.Count > 0
            )
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@(Model.Tab == "customers" ? "Khách hàng" : "Tài khoản")</th>
                                <th>Liên hệ</th>
                                <th>Ngày tham gia</th>
                                <th>Đơn / Chi tiêu</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model.Customers.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="customer-name">
                                            <span class="customer-avatar" aria-hidden="true">
                                                @(string.IsNullOrWhiteSpace(customer.FullName) ? "?" : customer.FullName.Trim()[..1].ToUpperInvariant())
                                            </span>
                                            <div>
                                                <strong>@customer.FullName</strong>
                                                <small>@(customer.Roles.Contains("Admin") ? "Quản trị viên" : "Khách hàng")</small>
                                            </div>
                                        </div>
                                        <span class="badge @(customer.IsActive ? "success" : "neutral")">
                                            @(customer.IsActive ? "Hoạt động" : "Đã khóa")
                                        </span>
                                    </td>
                                    <td>
                                        @customer.Email
                                        <br />
                                        <small>@customer.PhoneNumber</small>
                                    </td>
                                    <td>@customer.CreatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @customer.OrderCount
                                        đơn
                                        <br />
                                        <span class="money-cell">@ShopPageModel.Vnd(customer.TotalSpent)</span>
                                    </td>
                                    <td>
                                        @if (Model.Tab == "customers")
                                        {
                                            <a
                                                class="button secondary small"
                                                href="/admin?tab=customers&q=@Uri.EscapeDataString(Model.Q ?? "")&page=@Model.PageNumber&customerId=@customer.Id#customer-orders">
                                                Lịch sử đơn
                                            </a>
                                            <details>
                                                <summary>Sửa hồ sơ</summary>
                                                <form method="post" asp-page-handler="Profile">
                                                    <input
                                                        type="hidden"
                                                        name="returnUrl"
                                                        value="@(HttpContext.Request.Path + HttpContext.Request.QueryString)" />
                                                    <input type="hidden" name="id" value="@customer.Id" />
                                                    <label class="field">
                                                        Họ tên
                                                        <input name="profile.FullName" value="@customer.FullName" minlength="2" maxlength="100" required />
                                                    </label>
                                                    <label class="field">
                                                        Điện thoại
                                                        <input
                                                            type="tel"
                                                            name="profile.PhoneNumber"
                                                            value="@customer.PhoneNumber"
                                                            required
                                                            maxlength="20" />
                                                    </label>
                                                    <button class="button small">Lưu hồ sơ</button>
                                                </form>
                                            </details>
                                        }
                                        else
                                        {
                                            <form
                                                method="post"
                                                asp-page-handler="Access"
                                                data-confirm="Lưu thay đổi vai trò và trạng thái tài khoản này?">
                                                <input
                                                    type="hidden"
                                                    name="returnUrl"
                                                    value="@(HttpContext.Request.Path + HttpContext.Request.QueryString)" />
                                                <input type="hidden" name="id" value="@customer.Id" />
                                                <label class="field">
                                                    Vai trò
                                                    <select name="access.Role">
                                                        <option value="Customer" selected="@(!customer.Roles.Contains("Admin"))">Khách hàng</option>
                                                        <option value="Admin" selected="@(customer.Roles.Contains("Admin"))">Quản trị viên</option>
                                                    </select>
                                                </label>
                                                <label>
                                                    <input name="access.IsActive" type="checkbox" value="true" checked="@customer.IsActive" />
                                                    Hoạt động
                                                    <input type="hidden" name="access.IsActive" value="false" />
                                                </label>
                                                <button class="button small">Lưu quyền</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.Error is null && Model.TotalCount == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <svg class="tab-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="10" cy="10" r="6" />
                            <path d="m15 15 6 6" />
                        </svg>
                    </div>
                    <h3>
                        @(string.IsNullOrWhiteSpace(Model.Q) && string.IsNullOrWhiteSpace(Model.Status) ? "Chưa có dữ liệu" : "Không tìm thấy kết quả")
                    </h3>
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Q) ? "Dữ liệu mới sẽ xuất hiện tại đây khi hệ thống có hoạt động." : "Thử từ khóa khác hoặc đặt lại bộ lọc để xem tất cả.")
                    </p>
                    <a class="button secondary" href="/admin?tab=@Model.Tab">Đặt lại bộ lọc</a>
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination" aria-label="Phân trang quản trị">
                    @if (Model.PageNumber > 1)
                    {
                        <a
                            href="/admin?tab=@Model.Tab&q=@Uri.EscapeDataString(Model.Q ?? "")&status=@Model.Status&page=@(Model.PageNumber - 1)">
                            ← Trước
                        </a>
                    }
                    @for (
                        var p = Math.Max(1, Model.PageNumber - 2);
                        p <= Math.Min(Model.TotalPages, Model.PageNumber + 2);
                        p++
                    )
                    {
                        <a
                            class="@(p == Model.PageNumber ? "active" : "")"
                            aria-current="@(p == Model.PageNumber ? "page" : null)"
                            href="/admin?tab=@Model.Tab&q=@Uri.EscapeDataString(Model.Q ?? "")&status=@Model.Status&page=@p">
                            @p
                        </a>
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a
                            href="/admin?tab=@Model.Tab&q=@Uri.EscapeDataString(Model.Q ?? "")&status=@Model.Status&page=@(Model.PageNumber + 1)">
                            Sau →
                        </a>
                    }
                </nav>
            }

            @if (Model.CustomerOrders is not null)
            {
                <section id="customer-orders" class="summary-card">
                    <h3>Lịch sử mua hàng</h3>
                    <p>
                        <a href="/admin?tab=customers&q=@Uri.EscapeDataString(Model.Q ?? "")&page=@Model.PageNumber">
                            Đóng lịch sử
                        </a>
                    </p>
                    @if (Model.CustomerOrders.Count == 0)
                    {
                        <p class="muted">Khách hàng chưa có đơn hàng.</p>
                    }
                    @foreach (var order in Model.CustomerOrders)
                    {
                        <partial name="_OrderCard" model="order" />
                    }
                </section>
            }
        }
    </section>
</div>
