@page "/checkout"
@model ElectroShop.RazorPages.Pages.Checkout.IndexModel
@{ViewData["Title"]="Thanh toán sandbox";}
<div class="page-heading"><div><span class="eyebrow">SANDBOX PAYMENT</span><h1>Thanh toán</h1></div><a class="button secondary" href="/cart">Quay lại giỏ hàng</a></div><div class="alert">Đây là cổng thanh toán mô phỏng phục vụ học tập. Không chuyển tiền thật và không thu thập thông tin thẻ.</div>
@if(Model.Error is not null){<div class="alert error">@Model.Error</div>}
@if(Model.Order is {} order){<partial name="_OrderCard" model="order"/>@if(order.PaymentStatus!=PaymentStatus.Success && order.OrderStatus!=OrderStatus.Cancelled){<section class="summary-card"><h2>Chọn kết quả mô phỏng</h2><p>Lần thử thất bại giữ nguyên giỏ và tồn kho. Bạn có thể thử lại cùng đơn hàng.</p><form method="post" asp-page-handler="Pay" class="card-actions"><input type="hidden" name="orderId" value="@order.Id"/><input type="hidden" name="attemptKey" value="@Model.AttemptKey"/><button class="button" name="success" value="true">Thanh toán thành công</button><button class="button secondary" name="success" value="false">Thanh toán thất bại</button></form></section>}else if(order.PaymentStatus==PaymentStatus.Success){<div class="alert success">Đã thanh toán đơn @order.OrderCode. Cảm ơn bạn đã mua sắm!</div><a class="button" href="/orders">Xem lịch sử đơn hàng</a>}<details><summary>Lịch sử thanh toán (@Model.Payments.Count)</summary>@foreach(var payment in Model.Payments){<p>@payment.TransactionCode · @ShopPageModel.PaymentState(payment.Status) · @ShopPageModel.Vnd(payment.Amount) @payment.FailureReason</p>}</details>}
else if(Model.Cart?.Items.Count>0){<form method="post" asp-page-handler="Create"><input asp-for="Input.CheckoutKey" type="hidden"/><input asp-for="AttemptKey" type="hidden"/><div class="cart-layout"><section class="summary-card"><h2>Thông tin giao hàng</h2><div asp-validation-summary="All" class="alert error"></div><div class="form-grid"><div class="field"><label asp-for="Input.ReceiverName">Họ tên người nhận</label><input asp-for="Input.ReceiverName" required maxlength="100" autocomplete="name"/><span asp-validation-for="Input.ReceiverName"></span></div><div class="field"><label asp-for="Input.ReceiverPhone">Số điện thoại</label><input asp-for="Input.ReceiverPhone" type="tel" required maxlength="20" autocomplete="tel"/><span asp-validation-for="Input.ReceiverPhone"></span></div><div class="field full-width"><label asp-for="Input.ShippingAddress">Địa chỉ giao hàng</label><textarea asp-for="Input.ShippingAddress" required minlength="10" maxlength="500" autocomplete="street-address"></textarea><span asp-validation-for="Input.ShippingAddress"></span></div><div class="field full-width"><label asp-for="Input.Note">Ghi chú (tùy chọn)</label><textarea asp-for="Input.Note" maxlength="1000"></textarea></div></div></section><aside class="summary-card"><h2>Đơn hàng của bạn</h2>@foreach(var item in Model.Cart.Items){<p>@item.Name × @item.Quantity <strong>@ShopPageModel.Vnd(item.LineTotal)</strong></p>}<hr/><p>Tổng thanh toán</p><p class="product-price">@ShopPageModel.Vnd(Model.Cart.TotalAmount)</p><h3>Chọn kết quả mô phỏng</h3><label class="radio-option"><input type="radio" name="success" value="true" checked/> Thanh toán thành công</label><label class="radio-option"><input type="radio" name="success" value="false"/> Thanh toán thất bại</label><p class="product-meta">Giá và tồn kho được API kiểm tra lại khi thanh toán.</p><button class="button full-width">Tạo đơn và thanh toán</button></aside></div></form>}

else if(Model.Error is null){<div class="empty-state"><h2>Chưa có sản phẩm để thanh toán</h2><a class="button" href="/">Khám phá sản phẩm</a></div>}
