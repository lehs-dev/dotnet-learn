@page
@model IndexModel
@{
    ViewData["Title"] = "Thiết bị công nghệ cho mỗi ngày";
}
<section class="hero">
    <div class="hero-copy">
        <span class="eyebrow">KHÔNG GIAN CÔNG NGHỆ CỦA BẠN</span>
        <h1>Công nghệ tốt.<br />Trải nghiệm mỗi ngày.</h1>
        <p>Từ góc làm việc đến những phút giải trí. Khám phá thiết bị phù hợp, với mức giá rõ ràng.</p>
        <a href="#catalog" class="button">Khám phá sản phẩm →</a>
        <div class="hero-benefits">
            <span>✓ Sản phẩm chọn lọc</span>
            <span>✓ Giá minh bạch</span>
            <span>✓ Thanh toán sandbox</span>
        </div>
    </div>
    <div class="hero-art">
        <img src="/_content/ElectroShop.UiKit/images/hero-banner.svg" alt="Laptop và thiết bị công nghệ" />
        <span class="badge">Thiết bị cho mọi ý tưởng</span>
    </div>
</section>
<section id="catalog">
    <div class="page-heading">
        <div>
            <span class="eyebrow">KHÁM PHÁ ELECTROSHOP</span>
            <h2>Sản phẩm nổi bật</h2>
        </div>
        <span>@(Model.Products?.TotalCount ?? 0) sản phẩm</span>
    </div>
    <form method="get" class="filters">
        <div class="field">
            <label for="q">Tìm sản phẩm</label>
            <input id="q" name="q" value="@Model.Q" placeholder="Tên sản phẩm..." />
        </div>
        <div class="field">
            <label for="category">Danh mục</label>
            <select id="category" name="categoryId">
                <option value="">Tất cả danh mục</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="sort">Sắp xếp</label>
            <select id="sort" name="sort">
                <option value="">Mới nhất</option>
                <option value="price-asc" selected="@(Model.Sort == "price-asc")">Giá tăng dần</option>
                <option value="price-desc" selected="@(Model.Sort == "price-desc")">Giá giảm dần</option>
            </select>
        </div>
        <button class="button">Áp dụng</button>
        <a class="button secondary" href="/">Đặt lại</a>
    </form>
    @if (Model.Error is not null)
    {
        <div class="alert error">@Model.Error</div>
    }
    else if (Model.Products?.Items.Count > 0)
    {
        <div class="product-grid">
            @foreach (var product in Model.Products.Items)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
        <nav class="pagination" aria-label="Phân trang">
            @for (var p = 1; p <= Model.Products.TotalPages; p++)
            {
                <a
                    class="button @(p == Model.Products.Page ? "" : "secondary") small"
                    href="/?q=@Uri.EscapeDataString(Model.Q ?? "")&categoryId=@Model.CategoryId&sort=@Model.Sort&page=@p#catalog">
                    @p
                </a>
            }
        </nav>
    }
    else
    {
        <div class="empty-state">
            <h3>Chưa tìm thấy sản phẩm</h3>
            <p>Hãy thử tên hoặc danh mục khác.</p>
        </div>
    }
</section>
