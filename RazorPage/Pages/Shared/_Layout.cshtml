<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · ElectroShop</title><link rel="stylesheet" href="/_content/ElectroShop.UiKit/css/shop.css"/></head>
<body><header class="site-header"><div class="container header-inner"><a class="logo" href="/"><span class="logo-mark">E</span>ElectroShop<span class="badge">.NET 10</span></a><form class="search-form" action="/" method="get"><input type="search" name="q" placeholder="Tìm sản phẩm bạn yêu thích..." aria-label="Tìm kiếm"/><button class="button small">Tìm kiếm</button></form><nav class="nav-links"><a href="/">Trang chủ</a><a href="/cart">Giỏ hàng</a><a href="/orders">Đơn hàng</a>@if(User.IsInRole("Admin")){<a href="/admin">Quản trị</a>}</nav><div class="account-actions">@if(User.Identity?.IsAuthenticated==true){<span>@User.Identity.Name</span><form method="post" action="/auth/logout">@Html.AntiForgeryToken()<button class="button secondary small">Đăng xuất</button></form>}else{<button class="button secondary small" type="button" data-open-dialog="login-dialog">Đăng nhập</button><button class="button small" type="button" data-open-dialog="register-dialog">Đăng ký</button>}</div></div></header>
<main class="container main-content">@if(TempData["Success"] is string success){<div class="alert success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="alert error" role="alert">@error</div>}@if(Context.Request.Query.ContainsKey("denied")){<div class="alert error">Bạn không có quyền truy cập khu vực này.</div>}@RenderBody()</main>
<footer class="site-footer"><div class="container footer-inner"><div><a class="logo" href="/"><span class="logo-mark">E</span> ElectroShop</a><p>Website phục vụ học tập .NET 10.</p></div><div><p>Thanh toán sandbox — không chuyển tiền thật.</p><small>Razor Pages · Blazor · MVC</small></div></div></footer>
<dialog class="auth-dialog" id="login-dialog"><div class="dialog-heading"><h2>Chào mừng trở lại</h2><button type="button" data-close-dialog aria-label="Đóng">×</button></div><p>Đăng nhập để tiếp tục mua sắm tại ElectroShop.</p><form action="/auth/login" method="post">@Html.AntiForgeryToken()<div class="field"><label for="login-email">Email</label><input id="login-email" type="email" name="Email" required autocomplete="username"/></div><div class="field"><label for="login-password">Mật khẩu</label><input id="login-password" type="password" name="Password" required autocomplete="current-password"/></div><button class="button full-width">Đăng nhập</button></form><p>Chưa có tài khoản? <button class="button secondary small" data-close-dialog data-open-dialog="register-dialog">Đăng ký</button></p></dialog>
<dialog class="auth-dialog" id="register-dialog"><div class="dialog-heading"><h2>Tạo tài khoản</h2><button type="button" data-close-dialog aria-label="Đóng">×</button></div><form action="/auth/register" method="post">@Html.AntiForgeryToken()<div class="field"><label>Họ tên<input name="FullName" required minlength="2" maxlength="100" autocomplete="name"/></label></div><div class="field"><label>Email<input name="Email" type="email" required autocomplete="email"/></label></div><div class="field"><label>Số điện thoại<input name="PhoneNumber" type="tel" required maxlength="20" autocomplete="tel"/></label></div><div class="field"><label>Mật khẩu<input name="Password" type="password" required minlength="8" autocomplete="new-password"/></label><small>Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small></div><div class="field"><label>Nhập lại mật khẩu<input name="ConfirmPassword" type="password" required minlength="8" autocomplete="new-password"/></label></div><button class="button full-width">Đăng ký</button></form></dialog>
<script src="/_content/ElectroShop.UiKit/js/shop.js"></script><script>if(new URLSearchParams(location.search).has('login'))document.getElementById('login-dialog')?.showModal();if(new URLSearchParams(location.search).has('register'))document.getElementById('register-dialog')?.showModal();</script>@await RenderSectionAsync("Scripts",required:false)
</body></html>
