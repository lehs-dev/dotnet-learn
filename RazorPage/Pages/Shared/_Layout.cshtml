@{
    var path = Context.Request.Path;
    var returnUrl = Context.Request.Query["ReturnUrl"].ToString();
    if (!Url.IsLocalUrl(returnUrl))
        returnUrl =
            Context.Request.Query.ContainsKey("login")
            || Context.Request.Query.ContainsKey("register")
            || Context.Request.Query.ContainsKey("auth")
                ? "/"
                : path + Context.Request.QueryString;
    var authError = TempData["AuthError"] as string;
    var authModal = TempData["AuthModal"] as string ?? "login";
}
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewData["Title"] · ElectroShop</title>
        <meta
            name="description"
            content="ElectroShop — khám phá thiết bị công nghệ, mua sắm và quản lý đơn hàng." />
        <link rel="stylesheet" href="/_content/ElectroShop.UiKit/css/shop.css" asp-append-version="true" />
    </head>
    <body>
        <a class="skip-link" href="#main-content">Đến nội dung chính</a>
        <header class="site-header">
            <div class="container header-inner">
                <a class="logo" href="/" aria-label="ElectroShop trang chủ">
                    <span class="logo-mark">E</span>
                    ElectroShop
                </a>
                <form class="search-form" action="/" method="get" role="search">
                    <input
                        type="search"
                        name="q"
                        value="@Context.Request.Query["q"]"
                        placeholder="Bạn đang tìm thiết bị gì?"
                        aria-label="Tìm kiếm sản phẩm" />
                    <button type="submit">Tìm kiếm</button>
                </form>
                <nav class="nav-links" aria-label="Điều hướng chính">
                    <a href="/" aria-current="@(path == "/" ? "page" : null)">Trang chủ</a>
                    <a href="/cart" aria-current="@(path.StartsWithSegments("/cart") ? "page" : null)">Giỏ hàng</a>
                    <a href="/orders" aria-current="@(path.StartsWithSegments("/orders") ? "page" : null)">Đơn hàng</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/admin" aria-current="@(path.StartsWithSegments("/admin") ? "page" : null)">Quản trị</a>
                    }
                </nav>
                <div class="account-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="account-name" title="@User.Identity.Name">@User.Identity.Name</span>
                        <form method="post" action="/auth/logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="button secondary small">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <button class="button secondary small" type="button" data-open-dialog="login-dialog">
                            Đăng nhập
                        </button>
                        <button class="button small" type="button" data-open-dialog="register-dialog">Đăng ký</button>
                    }
                </div>
            </div>
        </header>
        <main id="main-content" class="container main-content" tabindex="-1">
            @if (TempData["Success"] is string success)
            {
                <div class="alert success" role="status">@success</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert error" role="alert">@error</div>
            }
            @if (Context.Request.Query.ContainsKey("denied"))
            {
                <div class="alert error" role="alert">Bạn không có quyền truy cập khu vực này.</div>
            }
            @RenderBody()
        </main>
        <footer class="site-footer">
            <div class="container footer-inner">
                <div>
                    <a class="logo" href="/"><span class="logo-mark">E</span>ElectroShop</a>
                    <p>Công nghệ cho công việc. Cảm hứng cho mỗi ngày.</p>
                </div>
                <div>
                    <p>Thanh toán mô phỏng · Không chuyển tiền thật</p>
                    <a href="/admin/login">Khu vực quản trị</a>
                    <span class="footer-separator">·</span>
                    <small>Dự án học tập .NET 10</small>
                </div>
            </div>
        </footer>
        <dialog
            class="auth-dialog"
            id="login-dialog"
            aria-labelledby="login-title"
            data-auto-open="@(authError != null && authModal == "login" ? "true" : "false")">
            <div class="dialog-heading">
                <h2 id="login-title">Chào mừng trở lại</h2>
                <button type="button" data-close-dialog aria-label="Đóng">×</button>
            </div>
            @if (authError is not null && authModal == "login")
            {
                <div class="alert error" role="alert">@authError</div>
            }
            <p>Đăng nhập để mua sắm và theo dõi đơn hàng.</p>
            <form action="/auth/login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                <label class="field">
                    Email
                    <input type="email" name="Email" required maxlength="256" autocomplete="username" />
                </label>
                <label class="field">
                    Mật khẩu
                    <input type="password" name="Password" required autocomplete="current-password" />
                </label>
                <button type="submit" class="button full-width">Đăng nhập</button>
            </form>
            <p>
                Chưa có tài khoản?
                <button type="button" class="link-button" data-open-dialog="register-dialog">Đăng ký ngay</button>
            </p>
            <p><a href="/admin/login">Đăng nhập quản trị →</a></p>
        </dialog>
        <dialog
            class="auth-dialog"
            id="register-dialog"
            aria-labelledby="register-title"
            data-auto-open="@(authError != null && authModal == "register" ? "true" : "false")">
            <div class="dialog-heading">
                <h2 id="register-title">Tạo tài khoản</h2>
                <button type="button" data-close-dialog aria-label="Đóng">×</button>
            </div>
            @if (authError is not null && authModal == "register")
            {
                <div class="alert error" role="alert">@authError</div>
            }
            <form action="/auth/register" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                <label class="field">
                    Họ và tên
                    <input name="FullName" required minlength="2" maxlength="100" autocomplete="name" />
                </label>
                <label class="field">
                    Email
                    <input type="email" name="Email" required maxlength="256" autocomplete="email" />
                </label>
                <label class="field">
                    Số điện thoại
                    <input name="PhoneNumber" type="tel" required maxlength="20" autocomplete="tel" />
                </label>
                <label class="field">
                    Mật khẩu
                    <input name="Password" type="password" required minlength="8" autocomplete="new-password" />
                </label>
                <small>Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small>
                <label class="field">
                    Nhập lại mật khẩu
                    <input name="ConfirmPassword" type="password" required minlength="8" autocomplete="new-password" />
                </label>
                <button type="submit" class="button full-width">Đăng ký</button>
            </form>
            <p>
                Đã có tài khoản?
                <button type="button" class="link-button" data-open-dialog="login-dialog">Đăng nhập</button>
            </p>
        </dialog>
        <script src="/_content/ElectroShop.UiKit/js/shop.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
